# PostgreSQL Connection (leave unset for local in-memory prototype)
DATABASE_URL="postgresql://user:password@localhost:5432/novivet_db"

# Master JWT Auth Secret (minimum 32 characters in production)
JWT_SECRET=""

# Google OAuth Client ID (optional, required for real Google ID token verification)
GOOGLE_CLIENT_ID=""

# Cron Job Secret for scheduled tasks (x-cron-secret or Bearer authorization)
CRON_SECRET=""

# Demo Login Flag (disabled by default, automatically rejected in production/Cloud Run)
ALLOW_DEMO_LOGIN=false
DEMO_PASSWORD=""
DEMO_PIN=""

# Node Environment
NODE_ENV="development"
PORT=8080
